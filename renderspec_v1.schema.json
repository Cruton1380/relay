{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.systems/schemas/renderspec-v1.json",
  "title": "RenderSpec v1",
  "description": "Relay Physics Layer 2 → Layer 3 scene graph contract",
  "type": "object",
  "required": ["schema_version", "generated_from", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "relay-render-v1",
      "description": "MUST be exactly 'relay-render-v1'"
    },
    "generated_from": {
      "type": "object",
      "required": ["endpoint", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "API endpoint that generated this spec",
          "examples": ["/render/world", "/render/filament/work.W123"]
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp (ms) when generated",
          "minimum": 0
        },
        "commit_ref": {
          "type": "string",
          "description": "Optional commit reference if rendering specific commit"
        },
        "filament_id": {
          "type": "string",
          "description": "Optional filament ID if rendering specific filament"
        },
        "event_id": {
          "type": "number",
          "description": "Optional event ID if rendering at specific event",
          "minimum": 0
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "Scene graph nodes",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the scene",
      "properties": {
        "total_nodes": {
          "type": "number",
          "minimum": 0
        },
        "total_edges": {
          "type": "number",
          "minimum": 0
        },
        "bounding_box": {
          "$ref": "#/$defs/BoundingBox"
        }
      }
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "required": ["id", "kind", "transform", "material", "props"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, deterministic node ID"
        },
        "kind": {
          "type": "string",
          "enum": [
            "globe",
            "unit",
            "filament",
            "timebox",
            "building",
            "task",
            "shipment"
          ],
          "description": "Type of node"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic material tag (NOT RGB hex)",
          "pattern": "^[a-z_]+$"
        },
        "props": {
          "type": "object",
          "description": "Kind-specific properties"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        }
      }
    },
    "Transform": {
      "type": "object",
      "required": ["position", "rotation", "scale"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z] or [lat, lon, alt]"
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[pitch, yaw, roll] in degrees"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        }
      }
    },
    "Geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/PolylineGeometry"
        },
        {
          "$ref": "#/$defs/MeshGeometry"
        }
      ]
    },
    "PolylineGeometry": {
      "type": "object",
      "required": ["type", "points", "color", "width"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "polyline"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "description": "Array of [x, y, z] points"
        },
        "color": {
          "type": "string",
          "description": "Color (prefer semantic, but RGB allowed for polylines)",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "Line width"
        }
      }
    },
    "MeshGeometry": {
      "type": "object",
      "required": ["type", "mesh_ref"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "mesh"
        },
        "mesh_ref": {
          "type": "string",
          "description": "Reference to mesh asset"
        }
      }
    },
    "BoundingBox": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
